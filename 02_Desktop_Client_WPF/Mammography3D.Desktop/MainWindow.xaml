<Window x:Class="Mammography3D.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Mammography 3D"
        Height="640" Width="960" MinHeight="560" MinWidth="840"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Modern Clean Dark Theme Palette -->
        <SolidColorBrush x:Key="BgDark" Color="#0F172A" />
        <SolidColorBrush x:Key="CardBg" Color="#1E293B" />
        <SolidColorBrush x:Key="CardBorder" Color="#334155" />
        <SolidColorBrush x:Key="CardBorderActive" Color="#38BDF8" />
        <SolidColorBrush x:Key="PrimaryAccent" Color="#0284C7" />
        <SolidColorBrush x:Key="PrimaryAccentHover" Color="#0369A1" />
        <SolidColorBrush x:Key="SuccessGreen" Color="#10B981" />
        <SolidColorBrush x:Key="BlenderOrange" Color="#EA580C" />
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8" />

        <!-- Modern Button Style -->
        <Style x:Key="CleanButton" TargetType="Button">
            <Setter Property="Background" Value="#334155" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Big Launch Button -->
        <Style x:Key="LaunchButton" TargetType="Button" BasedOn="{StaticResource CleanButton}">
            <Setter Property="Background" Value="#0284C7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="20,12" />
        </Style>

        <!-- Blender Button -->
        <Style x:Key="BlenderButton" TargetType="Button" BasedOn="{StaticResource CleanButton}">
            <Setter Property="Background" Value="#EA580C" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Main Content (2 Columns) -->
            <RowDefinition Height="Auto" /> <!-- Bottom Status Bar & Log -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER (Minimalist & Clean) -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="16,12" Margin="0,0,0,14"
                BorderBrush="#334155" BorderThickness="1"
                MouseLeftButtonDown="Header_MouseDown" Cursor="SizeAll">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔬" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Mammography 3D" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                        <TextBlock Text="•  3D Reconstruction Launcher" FontSize="13" Foreground="#94A3B8" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Status Badge -->
                <Border Grid.Column="1" x:Name="StatusBadge" Background="#334155" CornerRadius="12" Padding="14,4" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusBadgeText" Text="Ready" FontWeight="Bold" FontSize="11" Foreground="#F8FAFC" />
                </Border>
            </Grid>
        </Border>

        <!-- 2. MAIN BODY (Left: Controls / Right: Preview & Results) -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Workflow & Launch Controls -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="16" Margin="0,0,10,0"
                    BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Step 1: Patient Selection -->
                        <RowDefinition Height="Auto" /> <!-- Step 2: Mode Selection Cards -->
                        <RowDefinition Height="*" />    <!-- Spacer -->
                        <RowDefinition Height="Auto" /> <!-- Step 3: Launch Button & Actions -->
                    </Grid.RowDefinitions>

                    <!-- Step 1: Patient Selector -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="1. SELECT PATIENT" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbPatientCase" Background="#0F172A" Foreground="#0F172A"
                                      FontSize="13" FontWeight="SemiBold" Height="32" VerticalContentAlignment="Center"
                                      SelectionChanged="CmbPatientCase_SelectionChanged" />
                            <Button Grid.Column="1" Content="🔄" ToolTip="Reload patients folder"
                                    Style="{StaticResource CleanButton}" Click="BtnRefreshPatients_Click"
                                    Margin="8,0,0,0" Width="36" Height="32" Padding="0" />
                        </Grid>
                    </StackPanel>

                    <!-- Step 2: Reconstruction Mode Options (3 Clean Cards) -->
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="2. CHOOSE RECONSTRUCTION TYPE" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8" />

                        <!-- Mode 1: Total -->
                        <Border x:Name="CardModeTotal" Background="#0F172A" CornerRadius="6"
                                BorderBrush="#38BDF8" BorderThickness="2" Margin="0,0,0,8" Padding="12,10"
                                Cursor="Hand" MouseLeftButtonDown="CardModeTotal_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🌐" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Complete Reconstruction" FontWeight="Bold" FontSize="13" Foreground="#38BDF8" />
                                    <TextBlock Text="15-Layer Breast + Spicular Tumor (Module 07)" FontSize="11" Foreground="#94A3B8" />
                                </StackPanel>
                                <RadioButton x:Name="RbModeTotal" Grid.Column="2" IsChecked="True" GroupName="ModeGroup"
                                             VerticalAlignment="Center" Checked="RbModeTotal_Checked" />
                            </Grid>
                        </Border>

                        <!-- Mode 2: Breast Surface -->
                        <Border x:Name="CardModeSurface" Background="#0F172A" CornerRadius="6"
                                BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,8" Padding="12,10"
                                Cursor="Hand" MouseLeftButtonDown="CardModeSurface_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🍈" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Breast Surface" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC" />
                                    <TextBlock Text="Skin envelope &amp; volumetrics (Module 05)" FontSize="11" Foreground="#94A3B8" />
                                </StackPanel>
                                <RadioButton x:Name="RbModeSurface" Grid.Column="2" GroupName="ModeGroup"
                                             VerticalAlignment="Center" Checked="RbModeSurface_Checked" />
                            </Grid>
                        </Border>

                        <!-- Mode 3: Lesion Only -->
                        <Border x:Name="CardModeLesion" Background="#0F172A" CornerRadius="6"
                                BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,8" Padding="12,10"
                                Cursor="Hand" MouseLeftButtonDown="CardModeLesion_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🎯" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Lesion Only (3D)" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC" />
                                    <TextBlock Text="Spicular mass SMRD 2015 (Module 04)" FontSize="11" Foreground="#94A3B8" />
                                </StackPanel>
                                <RadioButton x:Name="RbModeLesion" Grid.Column="2" GroupName="ModeGroup"
                                             VerticalAlignment="Center" Checked="RbModeLesion_Checked" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Step 3: Launch Button & Actions -->
                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <Button x:Name="BtnStartReconstruction" Content="▶   START RECONSTRUCTION"
                                Style="{StaticResource LaunchButton}" Click="BtnStartReconstruction_Click" Height="44" />

                        <!-- Action Buttons (Blender, Preview, Output) -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnOpenBlender" Grid.Column="0" Content="🎨 Blender"
                                    Style="{StaticResource BlenderButton}" Click="BtnOpenBlender_Click" Margin="0,0,4,0" Height="32" />
                            <Button x:Name="BtnOpenPreview" Grid.Column="1" Content="🖼 3D Render"
                                    Style="{StaticResource CleanButton}" Click="BtnOpenPreview_Click" Margin="2,0,4,0" Height="32" />
                            <Button x:Name="BtnOpenFolder" Grid.Column="2" Content="📂" ToolTip="Open output folder"
                                    Style="{StaticResource CleanButton}" Click="BtnOpenFolder_Click" Width="36" Height="32" Padding="0" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RIGHT COLUMN: Preview & Results Summary -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Padding="16"
                    BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Section Title -->
                        <RowDefinition Height="*" />    <!-- Visual Preview (3D Render or Radiographs) -->
                        <RowDefinition Height="Auto" /> <!-- Clean Metric Cards (3 Simple Stats) -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="3D PREVIEW &amp; CLINICAL RESULTS" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,10" />

                    <!-- Visual Preview Area -->
                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="6" BorderBrush="#334155" BorderThickness="1"
                            ClipToBounds="True" Margin="0,0,0,12">
                        <Grid>
                            <!-- 3D Render Preview (if available) -->
                            <Image x:Name="ImgMainPreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />

                            <!-- Fallback: Side-by-side CC and MLO Radiographs -->
                            <Grid x:Name="GridRadiographsFallback" Visibility="Collapsed" Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Margin="0,0,4,0" Background="#0B132B" CornerRadius="4">
                                    <Image x:Name="ImgThumbCC" Stretch="Uniform" />
                                </Border>
                                <Border Grid.Column="1" Margin="4,0,0,0" Background="#0B132B" CornerRadius="4">
                                    <Image x:Name="ImgThumbMLO" Stretch="Uniform" />
                                </Border>
                            </Grid>

                            <!-- Placeholder when no model yet -->
                            <TextBlock x:Name="TxtNoPreviewPlaceholder" Text="No render generated yet.&#x0a;Press 'Start Reconstruction'."
                                       Foreground="#64748B" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <!-- Clean Metric Cards (3 Essential Badges) -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Stat 1: Breast Volume -->
                        <Border Grid.Column="0" Background="#0F172A" CornerRadius="6" Padding="10" Margin="0,0,4,0">
                            <StackPanel>
                                <TextBlock x:Name="LblStat1" Text="Breast Volume" FontSize="10" Foreground="#94A3B8" />
                                <TextBlock x:Name="TxtStat1" Text="--" FontSize="15" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Stat 2: Tumor Volume / Dimensions -->
                        <Border Grid.Column="1" Background="#0F172A" CornerRadius="6" Padding="10" Margin="2,0,2,0">
                            <StackPanel>
                                <TextBlock x:Name="LblStat2" Text="Tumor Volume" FontSize="10" Foreground="#94A3B8" />
                                <TextBlock x:Name="TxtStat2" Text="--" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Stat 3: Diagnosis / Localization -->
                        <Border Grid.Column="2" Background="#0F172A" CornerRadius="6" Padding="10" Margin="4,0,0,0">
                            <StackPanel>
                                <TextBlock x:Name="LblStat3" Text="Clinical Diagnosis" FontSize="10" Foreground="#94A3B8" />
                                <TextBlock x:Name="TxtStat3" Text="--" FontSize="13" FontWeight="Bold" Foreground="#F43F5E" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. BOTTOM: PROGRESS BAR & STATUS LOG -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="14,10"
                BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Status line + Percentage -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtStatusMessage" Text="Ready to start 3D reconstruction."
                               Foreground="#CBD5E1" FontSize="12" FontStyle="Italic" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" x:Name="TxtProgressPercent" Text="0%"
                               FontWeight="Bold" FontSize="12" Foreground="#38BDF8" />
                </Grid>

                <!-- Clean Progress Bar -->
                <ProgressBar Grid.Row="1" x:Name="ProgressBarReconstruction" Height="8" Minimum="0" Maximum="100" Value="0"
                             Background="#0F172A" Foreground="#0284C7" BorderThickness="0" />
            </Grid>
        </Border>
    </Grid>
</Window>
